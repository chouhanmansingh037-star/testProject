# --- API server (server/index.ts) ---
PORT=4000
# API binds to loopback by default; set HOST=0.0.0.0 only behind a trusted proxy
HOST=127.0.0.1
# "mock" (default, no key needed) or "anthropic"
LLM_PROVIDER=mock
# Only read server-side. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Failure drills for the mock provider: ok | timeout | error | auth | malformed | hallucinated | empty | partial
MOCK_MODE=ok
LLM_TIMEOUT_MS=8000
# Rate limits (per window of 60s)
RATE_LIMIT_SESSION_MAX=20
RATE_LIMIT_IP_MAX=60

# --- Next.js ---
BACKEND_URL=http://127.0.0.1:4000
